<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="../Core/Degerli.Core.csproj" />
    <ProjectReference Include="../Ingestion/Degerli.Ingestion.csproj" />
    <ProjectReference Include="../Persistence/Degerli.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />

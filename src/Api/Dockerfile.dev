# Development image for the API + in-process data-platform workers (AD-04).
# The same image carries the ContentPipeline console app as an alternate entrypoint.
FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /app

ENV DOTNET_USE_POLLING_FILE_WATCHER=true \
    DOTNET_CLI_TELEMETRY_OPTOUT=true \
    DOTNET_NOLOGO=true \
    ASPNETCORE_ENVIRONMENT=Development \
    ASPNETCORE_URLS=http://+:8080

COPY Degerli.sln ./
COPY Directory.Build.props ./
COPY .config/ ./.config/
COPY src/ ./src/

EXPOSE 8080

# `dotnet watch` rebuilds on the hot-reload bind mounts declared in compose.dev.yml.
ENTRYPOINT ["dotnet", "watch", "--project", "src/Api/Degerli.Api.csproj", "run", "--no-launch-profile"]

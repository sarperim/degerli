{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/degerli-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Ingestion": {
    "Scheduler": {
      "Enabled": true,
      "Cron": "0 30 20 * * *",
      "MorningCron": "0 30 8 * * *",
      "TimeZone": "Europe/Istanbul",
      "RetryDelays": [ "00:05:00", "00:15:00", "01:00:00" ],
      "JobSchedules": [
        { "JobCode": "macro-daily", "Cron": "0 0 8 * * *" },
        { "JobCode": "macro-cpi", "Cron": "0 30 9 * * *" },
        { "JobCode": "fund-nav", "Cron": "0 0 19 * * *" },
        { "JobCode": "fund-performance", "Cron": "0 5 19 * * *" },
        { "JobCode": "fund-holdings", "Cron": "0 10 19 * * *" },
        { "JobCode": "intraday-quotes", "Cron": "0 15 11,13,15,17 * * 1-5", "TradingDaysOnly": true }
      ]
    },
    "TradingCalendar": {
      "Holidays": [
        "2025-01-01",
        "2025-03-31",
        "2025-04-01",
        "2025-04-23",
        "2025-05-01",
        "2025-05-19",
        "2025-06-06",
        "2025-06-09",
        "2025-07-15",
        "2025-10-29",
        "2026-10-29"
      ]
    },
    "Prices": {
      "BaseUrl": "https://www.isyatirim.com.tr",
      "Path": "/_layouts/15/IsYatirim.Website/Common/Data.aspx/HisseTekil?hisse={symbol}&startdate={date}&enddate={date}",
      "BackfillPath": "/_layouts/15/IsYatirim.Website/Common/Data.aspx/HisseTekil?hisse={symbol}&startdate={from}&enddate=31-12-2099",
      "UniverseIndex": "XU100",
      "RequestDelayMs": 500
    },
    "Intraday": {
      "BaseUrl": "https://www.isyatirim.com.tr",
      "Path": "/_layouts/15/IsYatirim.Website/Common/ChartData.aspx/IntradayDelay?period=5&code={symbol}&last=108",
      "UniverseIndex": "XU100",
      "RequestDelayMs": 500
    },
    "Universe": {
      "BaseUrl": "https://www.isyatirim.com.tr",
      "Method": "POST",
      "Path": "/_layouts/15/IsYatirim.Website/StockInfo/CompanyInfoAjax.aspx/GetHissePerformans",
      "RequestBody": "{\"endeksKodu\":\"09\",\"sektorKodu\":\"\",\"exchange\":\"\"}",
      "IndexLevelsPath": "/_Layouts/15/IsYatirim.Website/Common/ChartData.aspx/IndexHistoricalAll?period=1440&from={from}&to={to}&endeks={index}",
      "IndexLevelsIndices": [ "XU100", "XU030" ],
      "IndexLevelsLookbackDays": 30
    },
    "Kap": {
      "BaseUrl": "https://apigwdev.mkk.com.tr/api/vyk",
      "ApiKey": "",
      "ApiSecret": "",
      "MembersPath": "/members",
      "LastDisclosureIndexPath": "/lastDisclosureIndex"
    },
    "KapPublic": {
      "BaseUrl": "https://www.kap.org.tr",
      "UserAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36 DegerliBot/0.1 (kap.org.tr public-site reader; polite, paced, single-flight)",
      "RequestDelayMs": "3000",
      "ByCriteriaPath": "/tr/api/disclosure/members/byCriteria",
      "ReportExportPath": "/tr/api/notification/export/excel/{disclosureIndex}",
      "IdentitySearchPath": "/tr/api/search/combined",
      "CompanyPagePath": "/tr/sirket/{ticker}",
      "RobotsPath": "/robots.txt",
      "MaxListPages": "40",
      "MaxDetailFetches": "200",
      "DetailFetchTimeoutMs": "60000",
      "RequestTimeoutMs": "30000",
      "MaxWalkDuration": "01:30:00",
      "AutomatedAccess": "Allowed"
    },
    "Statements": {
      "Source": "vyk",
      "Path": "/disclosures",
      "DetailPath": "/disclosureDetail/{disclosureIndex}",
      "DisclosureClass": "FR",
      "EarlyDisclosureIndex": "0",
      "UniverseIndex": "XU030",
      "RequestDelayMs": 10000
    },
    "Dividends": {
      "Path": "/disclosures",
      "DetailPath": "/disclosureDetail/{disclosureIndex}",
      "DisclosureType": "CA",
      "DividendEventType": "KP",
      "EarlyDisclosureIndex": "0",
      "UniverseIndex": "XU030"
    },
    "CorporateActions": {
      "Path": "/disclosures",
      "DetailPath": "/disclosureDetail/{disclosureIndex}",
      "DisclosureType": "CA",
      "EarlyDisclosureIndex": "0",
      "UniverseIndex": "XU030"
    },
    "Disclosures": {
      "Source": "vyk",
      "Path": "/disclosures",
      "DetailPath": "/disclosureDetail/{disclosureIndex}",
      "DisclosureType": "",
      "EarlyDisclosureIndex": "0",
      "UniverseIndex": "XU030",
      "Feed": "market",
      "BootstrapLookback": "5000",
      "MarketBootstrapLookback": "1000",
      "MaxListPages": "24",
      "MaxDetailFetches": "200",
      "MaxWalkDuration": "01:30:00"
    },
  "Macro": {
      "BaseUrl": "https://evds3.tcmb.gov.tr",
      "Path": "/igmevdsms-dis/fe",
      "CatalogPath": "/igmevdsms-dis/categories/withDatagroups/type=json",
      "SerieListPath": "/igmevdsms-dis/serieList/fe/type=json&code={code}",
      "EvdsApiKey": ""
    },
    "MarketSnapshot": {
      "VolumeEligibilityThreshold": 10000000
    }
  },
  "Auth": {
    "NoticeVersions": [ "2026-10" ],
    "UserRefHashKey": "degerli-dev-user-ref-hash-key",
    "AppUrl": "http://localhost:5173"
  }
}

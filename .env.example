# Değerli — environment template (architecture §10.4).
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never be
# committed: the repository is public and images carry no secrets (runtime env only).
#
#   cp .env.example .env
#
# Every value has a safe local default in compose.dev.yml, so a fresh clone can run
# `docker compose -f compose.dev.yml up` without an `.env` file at all.

# --- PostgreSQL (used by the compose.dev.yml postgres service) -----------------
# Changing these requires updating ConnectionStrings__Default to match.
POSTGRES_USER=degerli
POSTGRES_PASSWORD=degerli
POSTGRES_DB=degerli

# --- Database connection (ASP.NET configuration key: ConnectionStrings:Default) --
# Local `dotnet run` on the host uses localhost; inside compose the service name
# `postgres` is the default. Keep username/password in sync with POSTGRES_* above.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=degerli;Username=degerli;Password=degerli

# --- SMTP (transactional e-mail: verification, reset, pipeline alerts) ----------
# Locally this points at MailPit (SMTP 1025, web UI http://localhost:8025).
# Production uses Brevo's free tier.
Smtp__Host=localhost
Smtp__Port=1025
Smtp__User=
Smtp__Password=
Smtp__From=no-reply@degerli.local
# Keep true for the production VPS (Brevo requires STARTTLS). Set false only for
# the local MailPit container, which does not speak TLS — the dev compose stack
# already forces false, so this template default is safe to copy for the VPS.
Smtp__UseStartTls=true

# --- evren API (offline content pipeline AI drafting, C4) ----------------------
Evren__ApiKey=

# --- Daily price / index-level source (Ingestion:Prices:*) ---------------------
# Primary: İş Yatırım public endpoints (10Y historical EOD + index levels) — OQ-MDF-001
# resolved. Every stored daily_prices/index_levels row records its concrete source_ref
# (isyatirim).
# Contingency: Yahoo Finance (`.IS` tickers). To fail over, point BaseUrl at the Yahoo
# host — the same adapter parses either envelope and stamps source_ref = yahoo.
# BackfillPath carries the {from} query the adapter appends (10Y history request).
Ingestion__Prices__BaseUrl=
Ingestion__Prices__Path=/prices/eod
Ingestion__Prices__BackfillPath=/prices/history

# --- Macro source — TCMB EVDS 3.0 (Ingestion:Macro:*, FR-MOV-014) --------------
# OQ-MOV-005 re-resolved on the NEW platform: the five official series (TÜİK CPI, CBRT
# repo, USD/TRY, EUR/TRY, GOLD) come from one TCMB EVDS 3.0 adapter. The old EVDS v2 host
# blanket-redirects to https://evds3.tcmb.gov.tr and its REST paths + TP.* codes are gone.
# The v3 values endpoint (POST /igmevdsms-dis/fe) is ANONYMOUS — no API key, no login
# (live-verified 2026-10-18); the series are discovered from the anonymous catalog +
# serieList. EvdsApiKey is therefore optional (leave empty); if set it is only ever used
# as a redaction surface and is never committed.
Ingestion__Macro__BaseUrl=https://evds3.tcmb.gov.tr
Ingestion__Macro__Path=/igmevdsms-dis/fe
Ingestion__Macro__CatalogPath=/igmevdsms-dis/categories/withDatagroups/type=json
Ingestion__Macro__SerieListPath=/igmevdsms-dis/serieList/fe/type=json&code={code}
Ingestion__Macro__EvdsApiKey=

# --- KAP VYK API credentials (MKK "KAP Data Dissemination Services", FR-MDF-002) ---------
# OQ-026 resolved: financial statements come from MKK's official KAP VYK REST API
# (an Apinizer gateway). Live-verified auth (2026-10-18): HTTP Basic with the API Key as
# the username and the API Secret as the password. `appsettings.json` ships the dev gateway
# (https://apigwdev.mkk.com.tr/api/vyk) and empty credentials; set them here (or in the VPS
# `.env`) — they are secrets and must never be committed. The statements loop is
# company-scoped and paced at ~10 s/call by the free plan.
Ingestion__Kap__ApiKey=
Ingestion__Kap__ApiSecret=

# --- Application ---------------------------------------------------------------
# Public base URL of the site, used to build links in e-mail.
APP_URL=http://localhost:5173
# Where operational alerts (pipeline failures, staleness) are sent.
ALERT_EMAIL=builder@degerli.local

# --- Production only (compose.prod.yml; ignored by the local dev stack) ---------
# The VPS `.env` must also override the values above: APP_URL=https://<domain>,
# a real POSTGRES_PASSWORD, a real ConnectionStrings__Default pointing at `postgres`,
# and Brevo SMTP credentials. See deploy/README.md.
DOMAIN=degerli.example
# Pin the deployed image tag. Unset / `latest` follows the newest deploy; set it to a
# previous short SHA to roll back (deploy/README.md §Rollback).
IMAGE_TAG=latest
# Optional image overrides (defaults shown).
#API_IMAGE=ghcr.io/sarperim/degerli/api
#WEB_IMAGE=ghcr.io/sarperim/degerli/web

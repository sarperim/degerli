# Backup environment (TKT-int-006). Copy to a root-only file on the VPS, e.g.
#
#   sudo install -m 600 /dev/null /etc/degerli/backup.env
#   sudo editor /etc/degerli/backup.env
#
# and load it from the crontab line (see deploy/README.md §Backups):
#
#   0 3 * * * set -a; . /etc/degerli/backup.env; set +a; /opt/degerli/deploy/backup/pg-backup.sh >> /var/log/degerli-backup.log 2>&1
#
# This file is SEPARATE from the compose `.env` on purpose: that file is Docker
# Compose syntax (unquoted values may contain `;`, which a shell would mis-parse).
# Keep this one shell-correct. It is never committed.

# Symmetric AES-256 backup key. Generate with: openssl rand -base64 48
# Store a copy in a password manager — without it the backups cannot be restored.
BACKUP_PASSPHRASE=

# rclone remote + path of the Backblaze B2 bucket (configure `rclone config` once).
RCLONE_REMOTE=b2:degerli-backups

# Optional overrides (defaults shown):
#BACKUP_DIR=/opt/degerli/backups
#BACKUP_RETENTION_DAYS=30
#COMPOSE_FILE=/opt/degerli/compose.prod.yml
